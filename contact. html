<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Contact - Official Dashboard</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
          <style>
              @media (min-width: 768px) {
                      .sidebar { min-width: 260px; max-width: 260px; min-height: 100vh; }
              }
                </style>
                </head>
                <body class="d-flex flex-column flex-md-row bg-body">

                  <aside class="sidebar bg-dark border-end border-secondary p-4 d-flex flex-column flex-shrink-0">
                      <h3 class="h4 text-white fw-bold mb-4 border-bottom border-secondary pb-3">Dashboard Menu</h3>
                          <ul class="nav nav-pills flex-column mb-auto gap-1">
                                <li class="nav-item"><a href="index.html" class="nav-link text-secondary">Home</a></li>
                                      <li class="nav-item"><a href="about.html" class="nav-link text-secondary">About</a></li>
                                            <li class="nav-item"><a href="services.html" class="nav-link text-secondary">Services</a></li>
                                                  <li class="nav-item"><a href="contact.html" class="nav-link active fw-semibold">Contact</a></li>
                                                      </ul>
                                                        </aside>

                                                          <main class="flex-grow-1 p-4 p-md-5 bg-body-tertiary">
                                                              <div class="card bg-body border-secondary rounded-4 shadow-sm p-4 p-md-5 mb-4">
                                                                    <header class="mb-4 pb-3 border-bottom border-secondary">
                                                                            <h1 class="display-5 fw-bold text-light">Contact Administration</h1>
                                                                                    <p class="text-secondary fs-5 mb-0">Submit formal institutional inquiries</p>
                                                                                          </header>

                                                                                                <div class="row">
                                                                                                        <div class="col-lg-8">
                                                                                                                  <form action="#" method="POST">
                                                                                                                              <div class="mb-3">
                                                                                                                                            <label for="fullName" class="form-label fw-semibold text-secondary">Full Name</label>
                                                                                                                                                          <input type="text" class="form-control" id="fullName" placeholder="Enter your full name" required>
                                                                                                                                                                      </div>
                                                                                                                                                                                  <div class="mb-3">
                                                                                                                                                                                                <label for="emailAddress" class="form-label fw-semibold text-secondary">Email Address</label>
                                                                                                                                                                                                              <input type="email" class="form-control" id="emailAddress" placeholder="name@institution.edu" required>
                                                                                                                                                                                                                          </div>
                                                                                                                                                                                                                                      <div class="mb-3">
                                                                                                                                                                                                                                                    <label for="subject" class="form-label fw-semibold text-secondary">Subject</label>
                                                                                                                                                                                                                                                                  <input type="text" class="form-control" id="subject" placeholder="Inquiry subject heading" required>
                                                                                                                                                                                                                                                                              </div>
                                                                                                                                                                                                                                                                                          <div class="mb-4">
                                                                                                                                                                                                                                                                                                        <label for="message" class="form-label fw-semibold text-secondary">Message</label>
                                                                                                                                                                                                                                                                                                                      <textarea class="form-control" id="message" rows="5" placeholder="Enter your official message details..." required></textarea>
                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                              <button type="submit" class="btn btn-primary px-4">Submit Inquiry</button>
                                                                                                                                                                                                                                                                                                                                                        </form>
                                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                      </div>
                                                                                                                                                                                                                                                                                                                                                                          </div>
                                                                                                                                                                                                                                                                                                                                                                            </main>

                                                                                                                                                                                                                                                                                                                                                                              <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                                                                                                                                                                                                                                                                                                                                                                              </body>
                                                                                                                                                                                                                                                                                                                                                                              </html>
              }